Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: camera_link
    - Class: rviz_default_plugins/Image
      Name: RGB Camera
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud
      Enabled: true
      Topic:
        Value: /camera/depth/color/points
    - Class: rviz_default_plugins/Pose
      Name: Hand Pose
      Enabled: true
      Topic:
        Value: /hand_pose
      Shape: Axes
    - Class: rviz_default_plugins/Pose
      Name: Hand Pose Filtered
      Enabled: true
      Topic:
        Value: /hand_pose_filtered
      Shape: Arrow
  Global Options:
    Fixed Frame: camera_link
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Pitch: 0.3
      Yaw: 0.0